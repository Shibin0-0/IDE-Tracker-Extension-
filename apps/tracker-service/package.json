{
  "name": "@ide-usage-monitor/tracker-service",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only usage recording service with SQLite storage",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/**/*.test.js",
    "start": "node ./dist/index.js",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@ide-usage-monitor/shared": "*",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
