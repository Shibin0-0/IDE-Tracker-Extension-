# ============================================================
# Local-Only IDE Usage Monitor Configuration
# ============================================================
# NOTE: This application operates entirely locally on your machine.
# No data is transmitted to cloud services or external servers.
# ============================================================

# Network binding (strictly 127.0.0.1 for local security)
HOST=127.0.0.1
PORT=47392

# Local SQLite storage location
DATABASE_PATH=./data/ide-usage.db

# Logging level: 'error' | 'warn' | 'info' | 'debug'
LOG_LEVEL=info

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development
